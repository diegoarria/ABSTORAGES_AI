# ─── Monitoring — variables de entorno ───────────────────────────────────────
# TODAS estas conexiones apuntan a la base de datos DEDICADA de monitoring —
# nunca a la misma DATABASE_URL que usa SARA/SOFIA/NOA en la raíz del repo.

# Credenciales DUEÑAS de la base (las que da Railway al crear el servicio de
# Postgres nuevo) — solo se usan para roles.sql y migrate.js, nunca en runtime
# de las funciones de monitoreo ni del panel.
MONITORING_OWNER_DATABASE_URL=postgresql://postgres:xxxx@xxxx.railway.internal:5432/railway

# Rol de bajo privilegio para el cron/analizador (creado por roles.sql).
MONITORING_SERVICE_DATABASE_URL=postgresql://monitoring_service:CAMBIA_ESTA_CONTRASEÑA_1@xxxx.railway.internal:5432/railway

# Rol de solo-lectura (+resolver incidentes) para el panel admin (creado por roles.sql).
MONITORING_ADMIN_DATABASE_URL=postgresql://monitoring_admin:CAMBIA_ESTA_CONTRASEÑA_2@xxxx.railway.internal:5432/railway

# ─── Servicios a monitorear ───────────────────────────────────────────────────
VAPI_API_KEY=
ELEVENLABS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886
CLIENGO_HEALTH_URL=https://api.cliengo.com

# ─── Opcional: sobreescribir los endpoints de health-check por defecto ────────
# HEALTH_CHECK_URL_VAPI=https://api.vapi.ai/assistant
# HEALTH_CHECK_URL_ELEVENLABS=https://api.elevenlabs.io/v1/user

# ─── Alertas ──────────────────────────────────────────────────────────────────
ALERT_WHATSAPP_TO=+52XXXXXXXXXX

# Claude — mismo nombre de variable que el resto del repo
ANTHROPIC_API_KEY=

# ─── Panel admin ──────────────────────────────────────────────────────────────
MONITORING_ADMIN_PORT=4001
# Solo si el frontend (admin-panel) se despliega en un dominio distinto al de
# admin-server.js (ej. Vercel) — deja vacío si sirves dist/ desde este mismo servidor.
# ALLOWED_ORIGIN=https://tu-panel.vercel.app

# ─── Intake de eventos del negocio (server-lite.js → monitoring) ──────────────
MONITORING_INTAKE_SECRET=
