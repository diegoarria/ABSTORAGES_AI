# ─── ANTHROPIC ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── CLAVE PRIVADA DE DIEGO — ver backend/services/promptLeakGuard.js ─────────
# Única excepción para pedir credenciales del TMS por chat (sara/sofia/noa) sin
# que la IP/número quede baneado. La comparación es en código, el modelo nunca
# la conoce. NUNCA se usa para revelar el secreto real, solo para no banear.
DIEGO_PRIVATE_KEY=

# ─── PORTAL AUTH ──────────────────────────────────────────────────────────────
PORTAL_USERNAME=admin
PORTAL_PASSWORD=abstorages2025

# ─── POSTGRES ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/abstorages_portal

# ─── REDIS ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── WHATSAPP (Twilio) ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=+19383884379
WHATSAPP_VERIFY_TOKEN=abstorages

# ─── VAPI.AI ──────────────────────────────────────────────────────────────────
VAPI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── E0 PROSPECTOR — APIs de prospección real ────────────────────────────────
# Apollo.io — Plan gratuito incluye 50 exportaciones/mes
# Obtener en: https://developer.apollo.io/
APOLLO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Lusha — Requiere plan básico o superior
# Obtener en: https://www.lusha.com/docs/
LUSHA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ZoomInfo — Plataforma enterprise, requiere contrato
# Obtener en: https://api-docs.zoominfo.com/
ZOOMINFO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOOMINFO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LinkedIn — Requiere app aprobada por LinkedIn (OAuth2)
# Obtener en: https://developer.linkedin.com/
LINKEDIN_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GPS tracking — Token para unidades de transporte
GPS_TOKEN=abstorages-gps-2025

# ─── EMAIL (Resend — resend.com, plan gratis: 3,000 emails/mes) ──────────────
RESEND_API_KEY=re_xxxx
NOTIF_EMAIL=tu@correo.com
NOTIF_FROM_EMAIL=SARA <sara@tudominio.com>

# ─── NOTIFICACIÓN WHATSAPP AL EQUIPO (mismo 360dialog) ───────────────────────
# Número del equipo que recibe alertas de leads (formato sin + ni espacios)
NOTIF_WA_NUMBER=528112345678

# ─── WEBHOOK EXTERNO (n8n / Zapier / HubSpot / CRM) ─────────────────────────
LEAD_WEBHOOK_URL=https://your-n8n.com/webhook/sara-lead

# ─── LLAMADA DE SEGUIMIENTO VAPI ──────────────────────────────────────────────
# VAPI_FOLLOWUP=true → SARA llama automáticamente al lead al capturarlo
VAPI_FOLLOWUP=false
VAPI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPI_PHONE_NUMBER_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx           # SOFIA
VAPI_PHONE_NUMBER_ID_SARA=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx      # opcional — número dedicado de SARA (si no, usa el de SOFIA)
VAPI_PHONE_NUMBER_ID_NOA=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx       # opcional — número dedicado de NOA (si no, usa el de SOFIA)
VAPI_ASSISTANT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx        # SOFIA
VAPI_ASSISTANT_ID_SARA=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # opcional — assistant dedicado de SARA
VAPI_ASSISTANT_ID_NOA=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx    # opcional — assistant dedicado de NOA
VAPI_WEBHOOK_URL=https://tu-servidor.com

# NOA_AUTOLLAMADAS=true → NOA llama cada ~1.5h a proveedor/chofer y cliente
# por cada folio "En tránsito" pidiendo/dando estatus. Apagado por default:
# son llamadas reales y recurrentes con costo, a personas reales.
NOA_AUTOLLAMADAS=false

# ─── 2CHAT — MVP grupo de WhatsApp "ABSTORAGES IA - TEST" (SOFIA/NOA) ────────
# No es Twilio — WhatsApp Web automatizado (via QR), números aparte de los de
# producción para no arriesgarlos. Obtener API key en app.2chat.co → API Access.
TWOCHAT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWOCHAT_NUMBER_SOFIA=+52xxxxxxxxxx
TWOCHAT_NUMBER_NOA=+52xxxxxxxxxx
# Configurar en 2Chat el webhook whatsapp.group.message.received apuntando a:
# https://TU_DOMINIO/webhook/2chat

# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
